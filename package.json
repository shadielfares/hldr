{
  "name": "hldr-extension",
  "displayName": "HLDR Coding Mentor",
  "description": "An AI-driven coding mentor designed to enhance programming skills by providing guidance without directly supplying answers.",
  "publisher": "ShadiEl-Fares",
  "version": "1.0.0",
  "license": "SEE LICENSE",
  "repository": {
    "type": "git",
    "url": "https://github.com/shadielfares/hldr.git"
  },
  "icon": "./media/hldr.png",
  "engines": {
    "vscode": "^1.96.0"
  },
  "categories": [
    "Programming Languages",
    "AI",
    "Machine Learning",
    "Education"
  ],
  "keywords": [
    "javascript",
    "python",
    "typescript",
    "php",
    "autocomplete",
    "chat",
    "code completion",
    "ruby",
    "java",
    "go",
    "golang",
    "bash",
    "kotlin",
    "html",
    "css",
    "ocaml",
    "perl",
    "rust",
    "julia",
    "lua",
    "haskell",
    "c",
    "cpp",
    "c++",
    "csharp",
    "c#",
    "react",
    "swift",
    "objective-c",
    "objectivec",
    "ai",
    "method completion",
    "intellicode",
    "intellisense",
    "snippets",
    "kite",
    "nodejs",
    "node",
    "node.js",
    "jupyter",
    "documentation",
    "refactor",
    "AI copilot",
    "AI code snippets",
    "code suggestion",
    "code prediction",
    "code hinting",
    "content assist"
  ],
  "activationEvents": [
    "onDidSaveTextDocument"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "views": {
      "explorer": [
        {
          "type": "webview",
          "id": "hldr.view",
          "name": "H.L.D.R Code Mentor"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile && npm run lint",
    "lint": "eslint src",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@flydotio/dockerfile": "^0.5.9",
    "@types/mocha": "^10.0.10",
    "@types/node": "20.x",
    "@types/vscode": "^1.96.0",
    "@typescript-eslint/eslint-plugin": "^8.17.0",
    "@typescript-eslint/parser": "^8.17.0",
    "@vscode/test-cli": "^0.0.10",
    "@vscode/test-electron": "^2.4.1",
    "eslint": "^9.16.0",
    "typescript": "^5.7.2"
  },
  "dependencies": {
    "axios": "^1.7.9",
    "markdown-it": "^14.1.0",
    "marked": "^15.0.4"
  }
}
